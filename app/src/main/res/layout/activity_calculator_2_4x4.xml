                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="Multiply with"
                android:onClick="multiplyMatrixA"/>

            <EditText
                android:id="@+id/editTextScalarA"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberDecimal"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/transposeA"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Transpose"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:onClick="calculateTransposeA"/>

        <Button
            android:id="@+id/traceA"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Trace"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:onClick="calculateTraceA"/>

        <Button
            android:id="@+id/determinantA"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Determinant"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
