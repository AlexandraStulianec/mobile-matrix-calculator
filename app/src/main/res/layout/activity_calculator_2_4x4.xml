                    <EditText
                        android:id="@+id/B21"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B22"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B23"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B24"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/B31"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B32"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B33"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B34"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/B41"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B42"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B43"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                    <EditText
                        android:id="@+id/B44"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:maxLength="8"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonMultiplyB"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="Multiply with"
                android:onClick="multiplyMatrixB"/>

            <EditText
                android:id="@+id/editTextScalarB"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:inputType="numberDecimal"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/transposeB"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Transpose"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:onClick="calculateTransposeA"/>

        <Button
            android:id="@+id/traceB"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Trace"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:onClick="calculateTraceA"/>

        <Button
            android:id="@+id/determinantB"
            android:layout_width="175dp"
            android:layout_height="40dp"
            android:text="Determinant"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:onClick="calculateDeterminantA"/>



        <!-- Arithmetic Operations Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/buttonAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A + B"
                android:onClick="performAddition"/>

            <Button
                android:id="@+id/buttonSubtract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A - B"
                android:layout_marginStart="16dp"
                android:onClick="performSubtraction"
                />

            <Button
                android:id="@+id/buttonMultiply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A * B"
                android:layout_marginStart="16dp"
                android:onClick="performMultiplication"/>
        </LinearLayout>

        <!-- Buttons for controlling matrix size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >

            <Button
                android:id="@+id/buttonCleanMatrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clean"
                android:onClick="cleanMatrices"/>

            <Button
                android:id="@+id/buttonIncreaseMatrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="16dp"
                android:onClick="increaseMatrixSize"/>

            <Button
                android:id="@+id/buttonDecreaseMatrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_marginStart="16dp"
                android:onClick="decreaseMatrixSize"/>

        </LinearLayout>

        <!-- Result TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result Matrix"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"/>

        <!-- Result Matrix Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/R11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:background="#E0E0E0"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/R12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:background="#E0E0E0"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/R13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
