                android:background="#E0E0E0"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/R24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:background="#E0E0E0"
                android:padding="8dp"/>
